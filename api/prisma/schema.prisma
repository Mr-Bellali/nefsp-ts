// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model FoodCategory {
  idCategory   Int       @id @default(autoincrement())
  categoryName String
  idSection    Int
  products     Product[]
}

model ProductImage {
  idImage       Int     @id @default(autoincrement())
  imageFilename String
  productId     Int
  product       Product @relation(fields: [productId], references: [idProduct])
}

model Product {
  idProduct          Int            @id @default(autoincrement())
  productName        String
  originalPrice      Float
  expirationDate     DateTime
  sellingPrice       Float
  stockOte           Int
  productDescription String
  idCategory         Int
  idBrand            Int
  idProfile          String
  foodCategory       FoodCategory   @relation(fields: [idCategory], references: [idCategory])
  brand              Brand          @relation(fields: [idBrand], references: [idBrand])
  profile            Profile        @relation(fields: [idProfile], references: [idProfile])
  cartItems          CartItem[]
  productImgs        ProductImage[]
  tags               Tag[]
}

model Brand {
  idBrand          Int       @id @default(autoincrement())
  brandName        String
  brandDescription String
  products         Product[]
}

model Tag {
  idTag    Int       @id @default(autoincrement())
  nameTag  String
  products Product[]
}

model Cart {
  idCart     Int        @id @default(autoincrement())
  total      Float
  createdAt  DateTime   @default(now())
  modifiedAt DateTime   @updatedAt
  idProfile  String
  profile    Profile    @relation(fields: [idProfile], references: [idProfile])
  cartItems  CartItem[]
  order      Order?
}

model CartItem {
  idCartItem Int      @id @default(autoincrement())
  quantity   Int
  createdAt  DateTime @default(now())
  modifiedAt DateTime @updatedAt
  idProduct  Int
  idCart     Int
  product    Product  @relation(fields: [idProduct], references: [idProduct])
  cart       Cart     @relation(fields: [idCart], references: [idCart])
}

model Order {
  idOrder    Int      @id @default(autoincrement())
  total      Float
  createdAt  DateTime @default(now())
  modifiedAt DateTime @updatedAt
  idCart     Int      @unique
  cart       Cart     @relation(fields: [idCart], references: [idCart])
}

model User {
  idUser      String    @id
  name        String
  email       String    @unique
  password    String
  phoneNumber String    @unique
  profile     Profile?
  adresses    Address[]
}

model Profile {
  idProfile  String       @id
  pictureUrl String?
  role       ProfileRoles @default(CONSUMER)
  idUser     String       @unique
  user       User         @relation(fields: [idUser], references: [idUser])
  products   Product[]
  carts      Cart[]
}

model City {
  idCity   Int       @id @default(autoincrement())
  cityName String
  adress   Address[]
}

model Address {
  idAddress   Int    @id @default(autoincrement())
  addressData String
  userId      String
  cityId      Int
  user        User   @relation(fields: [userId], references: [idUser])
  city        City   @relation(fields: [cityId], references: [idCity])
}

enum ProfileRoles {
  SELLER
  CONSUMER
  ADMIN
}
